#!/bin/sh
# esurfing-macvlan-multidial -- run several authenticated CCTP sessions over
# one physical uplink using macvlan virtual interfaces in the root namespace.
#
# Each session is a separate MAC address on the same wire, so the upstream
# hands out a separate DHCP lease and the campus authenticator sees an
# independent client. No netns, no veth, no NAT: netifd owns DHCP and the
# per-session routing table, the dialer only owns the authorization.
#
#   esurfing-macvlan-multidial start            start every enabled session
#   esurfing-macvlan-multidial stop             stop everything it started
#   esurfing-macvlan-multidial status           print per-session health
#   esurfing-macvlan-multidial start-one NAME   start a single session
#   esurfing-macvlan-multidial stop-one  NAME   stop a single session
#
# Configuration lives in /etc/config/esurfing-multidial. See
# docs/multi-dial.md for the matching /etc/config/network block.

set -u

DIALER=/usr/bin/esurfingdialer
STATE_DIR=/tmp/esurfing-multidial-state
LEASE_HINT_DIR=/etc/esurfing-multidial/lease-hints
CAPTIVE_URL=${CAPTIVE_URL:-http://connect.rom.miui.com/generate_204}
LOGIN_PATTERN='The login has been authorized'
AUTH_TIMEOUT=75
DHCP_TIMEOUT=60
SETTLE_SECONDS=90

log() { logger -t esurfing-multidial "$*"; echo "$*"; }
fail() { log "ERROR: $*"; return 1; }

# ---------------------------------------------------------------- UCI helpers

opt() { uci -q get "esurfing-multidial.$1.$2" 2>/dev/null; }

session_names() {
	uci -q show esurfing-multidial 2>/dev/null | \
		sed -n "s/^esurfing-multidial\\.\\([^.]*\\)\\.parent=.*$/\\1/p" | sort -u
}

load_session() {
	NAME="$1"
	ENABLED="$(opt "$NAME" enabled)";   ENABLED="${ENABLED:-1}"
	PARENT="$(opt "$NAME" parent)"
	DEVICE="$(opt "$NAME" device)";     DEVICE="${DEVICE:-$NAME}"
	MAC="$(opt "$NAME" mac)"
	TABLE="$(opt "$NAME" table)"
	MARK="$(opt "$NAME" fwmark)"
	PRIO="$(opt "$NAME" priority)"
	BASE_CFG="$(opt "$NAME" base_config)"
	PORTAL_MAC="$(opt "$NAME" portal_mac)"

	[ -n "$PARENT" ] || { fail "$NAME: option parent is required"; return 1; }
	[ -n "$MAC" ]    || { fail "$NAME: option mac is required"; return 1; }
	return 0
}

# ------------------------------------------------------------ link and routes

ensure_link() {
	[ -e "/sys/class/net/$DEVICE" ] && return 0
	ip link add link "$PARENT" name "$DEVICE" type macvlan mode bridge \
		|| { fail "$NAME: cannot create macvlan $DEVICE on $PARENT"; return 1; }
	ip link set "$DEVICE" address "$MAC" || { fail "$NAME: cannot set MAC"; return 1; }
	log "$NAME: created macvlan $DEVICE on $PARENT mac=$MAC"
}

ensure_link_up() {
	ip link set "$DEVICE" up || { fail "$NAME: cannot bring up $DEVICE"; return 1; }
}

current_ip() {
	ip -4 -o addr show dev "$DEVICE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1
}

wait_for_ip() {
	local i
	for i in $(seq 1 "$DHCP_TIMEOUT"); do
		IP="$(current_ip)"
		[ -n "$IP" ] && return 0
		sleep 1
	done
	return 1
}

wait_for_table_default() {
	local i
	[ -n "$TABLE" ] || return 0
	for i in $(seq 1 15); do
		ip route show table "$TABLE" 2>/dev/null | grep -q '^default' && return 0
		sleep 2
	done
	return 1
}

ensure_source_rule() {
	local ip
	[ -n "$TABLE" ] && [ -n "$PRIO" ] || return 0
	ip="$(current_ip)"
	[ -n "$ip" ] || return 0
	ip rule show | grep -Eq "^$PRIO:.*from $ip lookup $TABLE$" && return 0
	ip rule del priority "$PRIO" 2>/dev/null
	ip rule add priority "$PRIO" from "$ip"/32 lookup "$TABLE" \
		&& log "$NAME: source rule ready $ip -> table $TABLE (priority $PRIO)"
}

# A stable MAC/IP pair keeps the upstream portal from seeing a new online
# session on every restart, which is what triggers "online user limit" errors.
persist_lease_hint() {
	local ip old
	ip="$(current_ip)"
	[ -n "$ip" ] || return 0
	mkdir -p "$LEASE_HINT_DIR"; chmod 700 "$LEASE_HINT_DIR"
	printf '%s\n' "$ip" > "$LEASE_HINT_DIR/$NAME"
	chmod 600 "$LEASE_HINT_DIR/$NAME"

	old="$(uci -q get "network.$NAME.ipaddr" 2>/dev/null)"
	[ "$old" = "$ip" ] && return 0
	uci set "network.$NAME.ipaddr=$ip" && uci commit network \
		&& log "$NAME: lease hint updated $old -> $ip"
}

# ------------------------------------------------------------------- dialer

stop_dialer() {
	local p cmd i
	[ -f "$STATE_DIR/$NAME.dialer.pid" ] || return 0
	p="$(cat "$STATE_DIR/$NAME.dialer.pid" 2>/dev/null)"
	if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
		cmd="$(tr '\000' ' ' < "/proc/$p/cmdline" 2>/dev/null)"
		case "$cmd" in
			*esurfingdialer*) ;;
			*) return 0 ;;
		esac
		log "$NAME: stopping dialer pid=$p"
		kill -TERM "$p" 2>/dev/null
		for i in $(seq 1 8); do
			kill -0 "$p" 2>/dev/null || return 0
			sleep 1
		done
		# Re-check /proc before escalating: the PID may have been reused.
		cmd="$(tr '\000' ' ' < "/proc/$p/cmdline" 2>/dev/null)"
		case "$cmd" in
			*esurfingdialer*) log "$NAME: WARN pid=$p ignored TERM, sending KILL"; kill -KILL "$p" 2>/dev/null ;;
			*) return 0 ;;
		esac
	fi
	return 0
}

start_dialer() {
	local json="/tmp/$NAME.json"

	[ -r "$BASE_CFG" ] || { fail "$NAME: base_config $BASE_CFG is not readable"; return 1; }
	cp "$BASE_CFG" "$json"; chmod 600 "$json"

	# Override the two options that must differ per session. Credentials stay
	# in the mode-0600 per-instance config; nothing secret is echoed here.
	sed -i "s|\"bind_fwmark\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"bind_fwmark\": \"$MARK\"|" "$json"
	sed -i 's|"bind_source_ip"[[:space:]]*:[[:space:]]*"[^"]*"|"bind_source_ip": ""|' "$json"

	# Build argv explicitly: an unquoted "${VAR:+--flag "$VAR"}" expansion would
	# pass the quote characters through to the child process.
	set -- -c "$json" --bind-interface "$DEVICE" --log-level info
	[ -n "$PORTAL_MAC" ] && set -- "$@" --portal-mac "$PORTAL_MAC"

	GOMAXPROCS=1 "$DIALER" "$@" > "/tmp/$NAME.dialer.log" 2>&1 &
	echo "$!" > "$STATE_DIR/$NAME.dialer.pid"
	log "$NAME: dialer started pid=$!"
}

wait_for_authorization() {
	local i
	for i in $(seq 1 "$AUTH_TIMEOUT"); do
		grep -q "$LOGIN_PATTERN" "/tmp/$NAME.dialer.log" 2>/dev/null && return 0
		if grep -qE 'standalone portal login failed|login error:|session initialization is still failing' \
			"/tmp/$NAME.dialer.log" 2>/dev/null; then
			# Redact URLs before echoing: ticket URLs carry the client address.
			sed -E 's#https?://[^ ]+#<url>#g' "/tmp/$NAME.dialer.log" | tail -n 12 >&2
			return 1
		fi
		sleep 1
	done
	return 1
}

verify_data_plane() {
	local code
	code="$(curl -sS --connect-timeout 5 --max-time 12 -o /dev/null \
		-w '%{http_code}' --interface "$DEVICE" "$CAPTIVE_URL" 2>/dev/null)"
	[ "$code" = "204" ] || { fail "$NAME: captive probe returned $code, expected 204"; return 1; }
	return 0
}

# ---------------------------------------------------------------- lifecycle

start_one() {
	load_session "$1" || return 1
	[ "$ENABLED" = "0" ] && { log "$NAME: disabled, skipping"; return 0; }

	ensure_link || return 1
	ensure_link_up || return 1

	ubus call "network.interface.$NAME" up >/dev/null 2>&1
	wait_for_ip || { fail "$NAME: no DHCP lease on $DEVICE"; return 1; }
	log "$NAME: lease $IP on $DEVICE"

	wait_for_table_default || { fail "$NAME: no default route in table $TABLE"; return 1; }
	ensure_source_rule
	persist_lease_hint

	start_dialer || return 1
	wait_for_authorization || { fail "$NAME: authorization timed out"; stop_dialer; return 1; }
	verify_data_plane || { stop_dialer; return 1; }

	mwan3 ifup "$NAME" >/dev/null 2>&1
	log "$NAME: ready ip=$IP device=$DEVICE captive=204"
	return 0
}

stop_one() {
	load_session "$1" || return 1
	mwan3 ifdown "$NAME" >/dev/null 2>&1
	stop_dialer
	persist_lease_hint
	ubus call "network.interface.$NAME" down >/dev/null 2>&1
	[ -n "$PRIO" ] && ip rule del priority "$PRIO" 2>/dev/null
	ip link del "$DEVICE" 2>/dev/null
	log "$NAME: stopped"
	return 0
}

status_one() {
	load_session "$1" || return 1
	local p state dialer dhcp table
	state="down"
	dialer="no"
	dhcp="$(current_ip)"; dhcp="${dhcp:-none}"
	if [ -e "/sys/class/net/$DEVICE" ]; then state="up"; fi
	p="$(cat "$STATE_DIR/$NAME.dialer.pid" 2>/dev/null)"
	if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then dialer="yes"; fi
	table="no"
	[ -n "$TABLE" ] && ip route show table "$TABLE" 2>/dev/null | grep -q '^default' && table="yes"
	printf '%s device=%s link=%s ip=%s dialer_alive=%s table_default=%s\n' \
		"$NAME" "$DEVICE" "$state" "$dhcp" "$dialer" "$table"
}

start_all() {
	local rc=0
	# Let the physical uplinks settle before opening extra MAC sessions: a
	# parent that is still authenticating makes the portal count this session
	# against a half-built parent identity.
	log "waiting ${SETTLE_SECONDS}s for parent uplinks to settle"
	sleep "$SETTLE_SECONDS"
	for NAME in $(session_names); do
		start_one "$NAME" || rc=1
	done
	return $rc
}

stop_all() {
	for NAME in $(session_names); do
		stop_one "$NAME"
	done
	return 0
}

health_loop() {
	while :; do
		sleep 30
		for NAME in $(session_names); do
			load_session "$NAME" >/dev/null 2>&1 || continue
			[ "$ENABLED" = "0" ] && continue
			p="$(cat "$STATE_DIR/$NAME.dialer.pid" 2>/dev/null)"
			if [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null; then
				log "$NAME: dialer died, stopping session"
				stop_one "$NAME"
				continue
			fi
			if [ -n "$TABLE" ] && ! wait_for_table_default; then
				log "$NAME: lost default route in table $TABLE"
			fi
			ensure_source_rule
		done
	done
}

mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"

case "${1:-}" in
	start)     start_all ;;
	stop)      stop_all ;;
	status)    for NAME in $(session_names); do status_one "$NAME"; done ;;
	start-one) start_one "${2:?usage: $0 start-one NAME}" ;;
	stop-one)  stop_one  "${2:?usage: $0 stop-one NAME}" ;;
	watch)     health_loop ;;
	*)         sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
