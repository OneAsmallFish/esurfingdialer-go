# /etc/config/mwan3 -- excerpt
#
# mwan3 does not dial. It only chooses which already-authorized uplink a flow
# leaves through, so every member below must have been proven to work with
# deploy/openwrt/usr/bin/esurfingdialer-nettest.sh first.

config globals 'globals'
	option mmx_mask '0x3F00'
	option rtmon_interval '5'

config interface 'wan'
	option enabled '1'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '10'
	option down '3'
	option up '3'

config interface 'wan2'
	option enabled '1'
	list track_ip '223.5.5.5'
	list track_ip '119.29.29.29'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '10'
	option down '3'
	option up '3'

# Keep the two virtual sessions out of the balanced set until you have read
# docs/multi-dial.md: on some campuses a third identity silently blackholes the
# two physical ones even though it authenticates successfully.
config interface 'vwan1'
	option enabled '0'
	list track_ip '223.5.5.5'
	option reliability '1'
	option count '1'
	option timeout '4'
	option interval '10'
	option down '3'
	option up '3'

config member 'wan_m1_w3'
	option interface 'wan'
	option metric '1'
	option weight '3'

config member 'wan2_m1_w3'
	option interface 'wan2'
	option metric '1'
	option weight '3'

config policy 'balanced'
	list use_member 'wan_m1_w3'
	list use_member 'wan2_m1_w3'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option family 'ipv4'
	option use_policy 'balanced'
