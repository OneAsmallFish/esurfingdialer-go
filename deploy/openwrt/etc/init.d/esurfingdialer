#!/bin/sh /etc/rc.common
# esurfingdialer procd service.
#
# One supervised process per "config instance" section in
# /etc/config/esurfingdialer, so a multi-WAN or multi-dial router runs one
# dialer per upstream and procd restarts only the process that died.

USE_PROCD=1
START=90
STOP=10

INTERFACES=

start_instance() {
	local section="$1"
	local enabled config_file iface bind_interface bind_fwmark bind_source_ip log_level

	config_get_bool enabled "$section" 'enabled' 1
	[ "$enabled" -eq 1 ] || return 0

	config_get config_file "$section" 'config_file' "/etc/esurfingdialer/$section.json"
	config_get iface "$section" 'interface' ''
	config_get bind_interface "$section" 'bind_interface' ''
	config_get bind_fwmark "$section" 'bind_fwmark' ''
	config_get bind_source_ip "$section" 'bind_source_ip' ''
	config_get log_level "$section" 'log_level' 'info'

	if [ ! -r "$config_file" ]; then
		logger -t esurfingdialer "instance $section: $config_file is not readable, skipping"
		return 0
	fi

	[ -n "$iface" ] && INTERFACES="$INTERFACES $iface"

	procd_open_instance "$section"
	procd_set_param command /usr/bin/esurfingdialer -c "$config_file" --log-level "$log_level"
	[ -n "$bind_interface" ] && procd_append_param command --bind-interface "$bind_interface"
	[ -n "$bind_fwmark" ] && procd_append_param command --bind-fwmark "$bind_fwmark"
	[ -n "$bind_source_ip" ] && procd_append_param command --bind-source-ip "$bind_source_ip"

	# The process is I/O bound, not CPU bound. One P per instance keeps the Go
	# scheduler footprint small on routers with 128-256 MB of RAM.
	procd_set_param env GOMAXPROCS=1 TZ=Asia/Shanghai
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 30
	procd_close_instance
}

start_service() {
	INTERFACES=
	config_load esurfingdialer
	config_foreach start_instance instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger esurfingdialer
	config_load esurfingdialer
	config_foreach add_interface_trigger instance
}

add_interface_trigger() {
	local section="$1" iface
	config_get iface "$section" 'interface' ''
	[ -n "$iface" ] && procd_add_reload_interface_trigger "$iface"
}
